# Database
DATABASE_URL=postgresql://user:password@localhost:5432/growlab

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# Environment
NODE_ENV=development

# ── F4 — Cloudflare R2 (image storage) ──────────────────────────────────────
# R2_ENDPOINT format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_NAME=growlab-photos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for your R2 bucket / custom domain (no trailing slash)
R2_PUBLIC_BASE_URL=https://photos.example.com

# ── F4 — AI Image Generation ─────────────────────────────────────────────────
# AI_PROVIDER: 'openai' (default, only supported value in F4)
AI_PROVIDER=openai
OPENAI_API_KEY=

# ── F5 — Sensor API key encryption ───────────────────────────────────────────
# AES-256-GCM key encryption key (KEK) — must be exactly 32 bytes (64 hex chars)
# Generate: openssl rand -hex 32
SENSOR_KEK=your-32-bytes-hex-key-here

# Optional: use mock sensor data in development (no real cloud API calls)
SENSOR_MOCK=false
